{
  "name": "@mlightcad/cad-pdf-plugin",
  "version": "1.7.8",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlightcad/cad-viewer.git"
  },
  "files": [
    "dist",
    "lib",
    "README.md",
    "package.json"
  ],
  "main": "./dist/cad-pdf-plugin.umd.cjs",
  "module": "./dist/cad-pdf-plugin.js",
  "sideEffects": false,
  "types": "./lib/index.d.ts",
  "typesVersions": {
    "*": {
      "sheets": [
        "lib/AcApSheetPdf.d.ts"
      ],
      "register": [
        "lib/register.d.ts"
      ]
    }
  },
  "exports": {
    "./sheets": {
      "types": "./lib/AcApSheetPdf.d.ts",
      "import": "./dist/cad-pdf-sheets.js",
      "require": "./dist/cad-pdf-sheets.cjs"
    },
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./dist/cad-pdf-plugin.js",
      "require": "./dist/cad-pdf-plugin.umd.cjs"
    },
    "./register": {
      "types": "./lib/register.d.ts",
      "import": "./dist/cad-pdf-plugin-register.js",
      "require": "./dist/cad-pdf-plugin-register.umd.cjs"
    }
  },
  "scripts": {
    "clean": "rimraf dist lib tsconfig.tsbuildinfo",
    "build": "tsc && vite build && vite build --config vite.sheets.config.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix --quiet src/"
  },
  "devDependencies": {
    "@mlightcad/cad-simple-viewer": "workspace:*",
    "@mlightcad/data-model": "1.15.21",
    "@mlightcad/mtext-parser": "1.5.7",
    "@mlightcad/pdf-renderer": "workspace:*",
    "@mlightcad/three-renderer": "workspace:*",
    "pdfjs-dist": "^5.6.205"
  },
  "peerDependencies": {
    "@mlightcad/cad-simple-viewer": "workspace:*",
    "@mlightcad/data-model": "1.15.21",
    "@mlightcad/mtext-parser": "1.5.7",
    "@mlightcad/pdf-renderer": "workspace:*",
    "@mlightcad/three-renderer": "workspace:*"
  },
  "dependencies": {
    "jspdf": "^4.2.1"
  }
}
